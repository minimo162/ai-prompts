            Variables.ConvertCustomObjectToJson CustomObject: { 'probe': CompareSource1 } Json=> CompareSource1Json
            Variables.ConvertCustomObjectToJson CustomObject: { 'probe': Saved1 } Json=> Saved1Json
            Variables.ConvertCustomObjectToJson CustomObject: { 'probe': CompareSource2 } Json=> CompareSource2Json
